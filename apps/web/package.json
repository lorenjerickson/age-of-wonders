  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0-rc.2",
