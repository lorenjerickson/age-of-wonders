generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Generation {
  id              String   @id @default(cuid())
  kind            String
  prompt          String
  output          String
  model           String
  responseId      String?
  createdByUserId String?
  contextType     String?
  contextId       String?
  createdAt       DateTime @default(now())
  createdBy       User?    @relation("GenerationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([createdByUserId, createdAt])
  @@index([createdByUserId, contextType, createdAt])
}

/// Versioned JSON documents for the aggregate roots in @aow/common.
/// The resource discriminator and canonical domain ID form the primary key.
model DomainRecord {
  resource  String
  id        String
  kind      String?
  name      String?
  data      Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([resource, id])
  @@index([resource, kind])
  @@index([resource, name])
  @@index([resource, updatedAt])
}

/// LevelGraph's six-way hexastore indexes, persisted in the same PostgreSQL
/// database as the relational application data.
model GraphEntry {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id              String   @id @default(uuid())
  bucket          String
  objectKey       String   @unique
  filename        String
  originalName    String
  mimeType        String
  mediaType       String
  purpose         String
  size            Int
  etag            String?
  tags            String[] @default([])
  createdByUserId String?
  scopeType       String?
  scopeId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User?    @relation("MediaAssetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([mediaType, purpose])
  @@index([mimeType])
  @@index([tags], type: Gin)
  @@index([createdAt])
  @@index([createdByUserId, createdAt])
  @@index([scopeType, scopeId])
}

enum UserRole {
  GM
  PARTICIPANT
}

enum CampaignRole {
  PLAYER
  SPECTATOR
}

enum MembershipStatus {
  ACTIVE
  BANNED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  CAPTURED
  FAILED
}

enum CharacterDraftStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETE
}

enum DefinitionLineageStatus {
  ACTIVE
  ARCHIVED
}

enum DefinitionDraftValidationStatus {
  NOT_VALIDATED
  VALID
  BLOCKED
}

enum ModelElementLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum CampaignInstanceStatus {
  PREPARING
  ACTIVE
  PAUSED
  CONCLUDED
  ARCHIVED
}

enum InstanceSnapshotReason {
  INITIAL
  MIGRATION
  RESTORE
}

enum CampaignInstanceRuntimeCheckpointReason {
  INITIAL
  MIGRATION_SOURCE
  MIGRATION_RESULT
  RESTORE_SOURCE
  RESTORE_RESULT
}

enum CampaignInstanceMigrationKind {
  MIGRATION
  RESTORE
}

enum InstallationRolloutPhase {
  PLANNED
  PREFLIGHT_READY
  BLOCKED
  SHADOW_WRITING
  READY_FOR_CUTOVER
  CUTOVER_IN_PROGRESS
  COMPLETE
  FAILED
}

enum PlayerServerStanding {
  ACTIVE
  INACTIVE
  BANNED
}

enum SystemAdministratorStatus {
  ACTIVE
  DISABLED
}

enum AuthenticationProviderAssociationStatus {
  PENDING
  ASSOCIATED
  DISABLED
}

enum CampaignInstanceHumanRole {
  GM
  PLAYER
  SPECTATOR
}

enum CampaignInstanceMembershipStatus {
  ACTIVE
  INACTIVE
  LEFT
  BANNED
}

enum CampaignInstanceInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AgentIdentityStatus {
  ACTIVE
  DISABLED
}

enum CampaignInstanceAgentParticipationStatus {
  CONFIGURED
  AUTHORIZED
  ACTIVE
  PAUSED
  REVOKED
}

enum CampaignInstanceSessionStatus {
  PLANNED
  LOBBY
  ACTIVE
  PAUSED
  CONCLUDED
  CANCELLED
}

enum SessionParticipantRole {
  GM
  PLAYER
  SPECTATOR
  AGENT
}

enum SessionInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum SessionPresencePhase {
  LOBBY
  PLAY
}

enum SessionEventVisibility {
  GM
  PARTICIPANTS
  PLAYERS
  SPECTATORS
  SESSION_PUBLIC
}

enum SessionBoundaryReason {
  START
  PAUSE
  RESUME_AFTER_MIGRATION
  CONCLUDE
}

enum SessionSummaryStatus {
  DRAFT
  APPROVED
  AMENDED
}

enum SessionResponseStatus {
  NOT_REQUESTED
  PENDING
  ACCEPTED
  DECLINED
}

enum SessionAttendanceStatus {
  PENDING
  NOT_ATTENDED
  ATTENDED
  EXCUSED
}

enum CampaignInstanceCharacterStatus {
  DRAFT
  ACTIVE
  INACTIVE
  RETIRED
  DEAD
}

enum CharacterAssociationOrigin {
  CREATED_IN_INSTANCE
  ONE_WAY_IMPORT
}

/// Authenticated people. Protected contact data remains outside generic resources.
model User {
  id                                         String                                  @id @default(uuid())
  displayName                                String
  role                                       UserRole
  createdAt                                  DateTime                                @default(now())
  updatedAt                                  DateTime                                @updatedAt
  authSessions                               AuthSession[]
  createdGenerations                         Generation[]                            @relation("GenerationCreator")
  uploadedMedia                              MediaAsset[]                            @relation("MediaAssetCreator")
  memberships                                CampaignMembership[]
  createdInvitations                         CampaignInvitation[]                    @relation("InvitationCreator")
  acceptedInvitations                        CampaignInvitation[]                    @relation("InvitationAcceptor")
  ownedWorldDefinitions                      WorldDefinition[]                       @relation("WorldDefinitionOwner")
  authoredWorldDefinitionRevisions           WorldDefinitionRevision[]               @relation("WorldRevisionAuthor")
  ownedCampaignDefinitions                   CampaignDefinition[]                    @relation("CampaignDefinitionOwner")
  authoredCampaignDefinitionRevisions        CampaignDefinitionRevision[]            @relation("CampaignRevisionAuthor")
  createdCampaignInstances                   CampaignInstance[]                      @relation("CampaignInstanceCreator")
  ownedCampaignInstances                     CampaignInstance[]                      @relation("CampaignInstanceOwner")
  capturedCampaignInstanceSnapshots          CampaignInstanceSnapshot[]              @relation("CampaignSnapshotAuthor")
  capturedCampaignInstanceRuntimeCheckpoints CampaignInstanceRuntimeCheckpoint[]     @relation("CampaignRuntimeCheckpointAuthor")
  appliedCampaignInstanceMigrations          CampaignInstanceMigrationAudit[]        @relation("CampaignInstanceMigrationActor")
  campaignInstanceAuditEvents                CampaignInstanceAuditEvent[]            @relation("CampaignInstanceAuditActor")
  initiatedInstallationRollouts              InstallationRolloutState[]              @relation("InstallationRolloutInitiator")
  installationRolloutAuditEvents             InstallationRolloutAudit[]              @relation("InstallationRolloutAuditActor")
  createdWorldDefinitionDrafts               WorldDefinitionDraft[]                  @relation("WorldDraftCreator")
  updatedWorldDefinitionDrafts               WorldDefinitionDraft[]                  @relation("WorldDraftUpdater")
  createdWorldDefinitionForks                WorldDefinitionForkProvenance[]         @relation("WorldForkCreator")
  ownedModelRegistries                       ModelRegistry[]                         @relation("ModelRegistryOwner")
  authoredModelElementRevisions              ModelElementRevision[]                  @relation("ModelElementRevisionAuthor")
  publishedModelSchemaReleases               ModelSchemaRelease[]                    @relation("ModelSchemaReleasePublisher")
  createdModelMigrationPlans                 ModelMigrationPlan[]                    @relation("ModelMigrationPlanCreator")
  createdCampaignDefinitionDrafts            CampaignDefinitionDraft[]               @relation("CampaignDraftCreator")
  updatedCampaignDefinitionDrafts            CampaignDefinitionDraft[]               @relation("CampaignDraftUpdater")
  createdCampaignDefinitionForks             CampaignDefinitionForkProvenance[]      @relation("CampaignForkCreator")
  appliedCampaignWorldMigrations             CampaignDefinitionWorldMigrationAudit[] @relation("CampaignWorldMigrationActor")
  playerProfile                              PlayerProfile?
  systemAdministrator                        SystemAdministrator?
  authenticationProviderAssociations         AuthenticationProviderAssociation[]
  campaignInstanceMemberships                CampaignInstanceHumanMembership[]
  createdCampaignInstanceInvitations         CampaignInstanceInvitation[]            @relation("CampaignInstanceInvitationCreator")
  invitedCampaignInstanceInvitations         CampaignInstanceInvitation[]            @relation("CampaignInstanceInvitationUser")
  ownedAgentIdentities                       AgentIdentity[]                         @relation("AgentIdentityOwner")
  createdCampaignSessions                    CampaignInstanceSession[]               @relation("CampaignSessionCreator")
  issuedSessionInvitations                   CampaignSessionInvitation[]             @relation("CampaignSessionInvitationIssuer")
  authoredSessionEvents                      CampaignSessionEvent[]                  @relation("CampaignSessionEventActor")
  createdSessionBoundaries                   CampaignSessionRuntimeBoundary[]        @relation("CampaignSessionBoundaryActor")
  createdSessionSummaries                    CampaignSessionSummary[]                @relation("CampaignSessionSummaryAuthor")
  reviewedCampaignInstanceCharacterDrafts    CampaignInstanceCharacterDraft[]        @relation("CampaignInstanceCharacterDraftReviewer")
}

/// Installation-level operator established during first launch. This role is
/// independent of Game Master authority even when the same User holds both.
model SystemAdministrator {
  id             String                    @id @default(uuid())
  singletonKey   Int                       @unique @default(1)
  userId         String                    @unique
  displayName    String
  emailEncrypted String
  emailHash      String                    @unique
  phoneEncrypted String
  phoneHash      String                    @unique
  status         SystemAdministratorStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, displayName])
}

/// Durable server-wide Player role, separate from any Campaign Instance.
model PlayerProfile {
  id                   String                              @id @default(uuid())
  userId               String                              @unique
  displayName          String
  standing             PlayerServerStanding                @default(ACTIVE)
  emailEncrypted       String?
  emailHash            String?                             @unique
  phoneEncrypted       String?
  phoneHash            String?                             @unique
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  user                 User                                @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerAssociations AuthenticationProviderAssociation[]
  campaignMemberships  CampaignInstanceHumanMembership[]

  @@unique([id, userId])
  @@index([standing, displayName])
}

/// Protected identity-provider linkage. Provider subjects and credentials are
/// retained only as encrypted, hashed, or external-reference values. Database
/// checks keep pending, associated, and disabled timestamps lifecycle-consistent.
model AuthenticationProviderAssociation {
  id                       String                                  @id @default(uuid())
  userId                   String
  playerProfileId          String?
  providerKey              String
  providerSubjectHash      String
  providerSubjectEncrypted String?
  credentialReference      String?
  status                   AuthenticationProviderAssociationStatus @default(PENDING)
  associatedAt             DateTime?
  disabledAt               DateTime?
  createdAt                DateTime                                @default(now())
  updatedAt                DateTime                                @updatedAt
  user                     User                                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  playerProfile            PlayerProfile?                          @relation(fields: [playerProfileId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([providerKey, providerSubjectHash])
  @@unique([userId, providerKey])
  @@index([userId, status])
  @@index([playerProfileId, status])
}

/// Stable identity for a non-human process. Execution credentials remain
/// outside this table and are addressed only by a protected reference.
model AgentIdentity {
  id                     String                               @id @default(uuid())
  ownerUserId            String
  name                   String
  description            String?
  status                 AgentIdentityStatus                  @default(ACTIVE)
  configurationReference String?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  owner                  User                                 @relation("AgentIdentityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  instanceParticipations CampaignInstanceAgentParticipation[]

  @@index([ownerUserId, status])
  @@index([name])
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CampaignMembership {
  id                String                   @id @default(uuid())
  campaignId        String
  userId            String
  role              CampaignRole
  status            MembershipStatus         @default(ACTIVE)
  displayName       String
  emailEncrypted    String?
  emailHash         String?
  phoneEncrypted    String?
  phoneHash         String?
  characterIds      Json                     @default("[]")
  activeCharacterId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterDrafts   CharacterCreationDraft[]

  @@unique([campaignId, userId])
  @@index([campaignId, role, status])
  @@index([campaignId, emailHash])
  @@index([campaignId, phoneHash])
  @@index([activeCharacterId])
}

model CampaignInvitation {
  id               String               @id @default(uuid())
  campaignId       String
  role             CampaignRole
  displayName      String
  emailEncrypted   String?
  emailHash        String?
  phoneEncrypted   String?
  phoneHash        String?
  tokenHash        String               @unique
  status           InvitationStatus     @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  reissuedFromId   String?
  createdByUserId  String
  acceptedByUserId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        User                 @relation("InvitationCreator", fields: [createdByUserId], references: [id])
  acceptedBy       User?                @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])
  deliveries       InvitationDelivery[]

  @@index([campaignId, status])
  @@index([campaignId, emailHash])
  @@index([campaignId, phoneHash])
  @@index([expiresAt])
}

model InvitationDelivery {
  id                String             @id @default(uuid())
  invitationId      String
  channel           DeliveryChannel
  status            DeliveryStatus     @default(PENDING)
  attempts          Int                @default(0)
  providerMessageId String?
  lastErrorCode     String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  invitation        CampaignInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, channel])
  @@index([status, createdAt])
}

/// Resumable player-owned workflow. A membership may own several characters.
model CharacterCreationDraft {
  id                     String               @id @default(uuid())
  membershipId           String
  characterId            String?
  revision               Int                  @default(1)
  status                 CharacterDraftStatus @default(IN_PROGRESS)
  name                   String?
  backgroundDefinitionId String?
  professionDefinitionId String?
  heritageDefinitionIds  Json                 @default("[]")
  attributeRolls         Json                 @default("[]")
  attributeAssignments   Json                 @default("{}")
  startingEquipmentIds   Json                 @default("[]")
  biography              String?
  imageAssetIds          Json                 @default("{}")
  archivedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  membership             CampaignMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, status])
  @@index([characterId])
}

/// Stable identity for a World across its immutable published revisions.
model WorldDefinition {
  id                String                          @id @default(uuid())
  name              String
  description       String?
  status            DefinitionLineageStatus         @default(ACTIVE)
  currentRevisionId String?                         @unique
  ownerUserId       String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  archivedAt        DateTime?
  owner             User?                           @relation("WorldDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  revisions         WorldDefinitionRevision[]       @relation("WorldDefinitionRevisions")
  currentRevision   WorldDefinitionRevision?        @relation("WorldDefinitionCurrentRevision", fields: [id, currentRevisionId], references: [worldDefinitionId, id], onDelete: Restrict)
  campaigns         CampaignDefinition[]
  draft             WorldDefinitionDraft?
  forkProvenance    WorldDefinitionForkProvenance?  @relation("ForkTargetWorld")
  forkSources       WorldDefinitionForkProvenance[] @relation("ForkSourceWorld")
  metadataRevision  Int                             @default(1)

  @@unique([id, currentRevisionId])
  @@index([status, updatedAt])
  @@index([ownerUserId, status])
}

/// Immutable, published content for one World Definition lineage.
model WorldDefinitionRevision {
  id                    String                                      @id @default(uuid())
  worldDefinitionId     String
  revisionNumber        Int
  predecessorRevisionId String?
  name                  String
  content               Json
  contentHash           String
  createdByUserId       String?
  createdAt             DateTime                                    @default(now())
  publishedAt           DateTime                                    @default(now())
  worldDefinition       WorldDefinition                             @relation("WorldDefinitionRevisions", fields: [worldDefinitionId], references: [id], onDelete: Restrict)
  currentForWorld       WorldDefinition?                            @relation("WorldDefinitionCurrentRevision")
  predecessorRevision   WorldDefinitionRevision?                    @relation("WorldRevisionLineage", fields: [worldDefinitionId, predecessorRevisionId], references: [worldDefinitionId, id], onDelete: Restrict)
  successorRevisions    WorldDefinitionRevision[]                   @relation("WorldRevisionLineage")
  createdBy             User?                                       @relation("WorldRevisionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  snapshots             WorldDefinitionSnapshot[]
  sourceDraftRevision   Int?
  worldDefinitionDrafts WorldDefinitionDraft[]
  modelSchemaSelections WorldDefinitionRevisionModelSchemaRelease[]

  @@unique([worldDefinitionId, revisionNumber])
  @@unique([worldDefinitionId, id])
  @@unique([worldDefinitionId, sourceDraftRevision])
  @@index([predecessorRevisionId])
  @@index([contentHash])
  @@index([publishedAt])
}

/// Immutable, content-addressed replica of one published World revision.
model WorldDefinitionSnapshot {
  id                        String                          @id @default(uuid())
  worldDefinitionId         String
  worldDefinitionRevisionId String
  manifest                  Json
  contentHash               String
  capturedAt                DateTime                        @default(now())
  worldDefinitionRevision   WorldDefinitionRevision         @relation(fields: [worldDefinitionId, worldDefinitionRevisionId], references: [worldDefinitionId, id], onDelete: Restrict)
  campaignRevisions         CampaignDefinitionRevision[]
  campaignSnapshots         CampaignDefinitionSnapshot[]
  instanceSnapshots         CampaignInstanceSnapshot[]
  basedDrafts               WorldDefinitionDraft[]
  forkSources               WorldDefinitionForkProvenance[]
  campaignDrafts            CampaignDefinitionDraft[]

  @@unique([id, worldDefinitionId])
  @@unique([id, worldDefinitionId, worldDefinitionRevisionId])
  @@unique([worldDefinitionId, worldDefinitionRevisionId])
  @@index([worldDefinitionId, worldDefinitionRevisionId])
  @@index([contentHash])
  @@index([capturedAt])
}

/// Mutable complete working state for the next publication in one World lineage.
model WorldDefinitionDraft {
  id                       String                          @id @default(uuid())
  worldDefinitionId        String                          @unique
  baseRevisionId           String?
  baseSnapshotId           String?
  revisionName             String
  content                  Json
  snapshotRecords          Json                            @default("[]")
  storageRevision          Int                             @default(1)
  validationStatus         DefinitionDraftValidationStatus @default(NOT_VALIDATED)
  validatedStorageRevision Int?
  validationReport         Json?
  createdByUserId          String
  updatedByUserId          String
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  worldDefinition          WorldDefinition                 @relation(fields: [worldDefinitionId], references: [id], onDelete: Restrict)
  baseRevision             WorldDefinitionRevision?        @relation(fields: [worldDefinitionId, baseRevisionId], references: [worldDefinitionId, id], onDelete: Restrict)
  baseSnapshot             WorldDefinitionSnapshot?        @relation(fields: [baseSnapshotId, worldDefinitionId, baseRevisionId], references: [id, worldDefinitionId, worldDefinitionRevisionId], onDelete: Restrict)
  createdBy                User                            @relation("WorldDraftCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                User                            @relation("WorldDraftUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([worldDefinitionId, validationStatus])
  @@index([baseSnapshotId])
}

/// Immutable provenance for a new World lineage copied from a selected snapshot.
model WorldDefinitionForkProvenance {
  targetWorldDefinitionId String                  @id
  sourceWorldDefinitionId String
  sourceSnapshotId        String
  identityMapping         Json
  createdByUserId         String
  createdAt               DateTime                @default(now())
  targetWorldDefinition   WorldDefinition         @relation("ForkTargetWorld", fields: [targetWorldDefinitionId], references: [id], onDelete: Restrict)
  sourceWorldDefinition   WorldDefinition         @relation("ForkSourceWorld", fields: [sourceWorldDefinitionId], references: [id], onDelete: Restrict)
  sourceSnapshot          WorldDefinitionSnapshot @relation(fields: [sourceSnapshotId, sourceWorldDefinitionId], references: [id, worldDefinitionId], onDelete: Restrict)
  createdBy               User                    @relation("WorldForkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([sourceWorldDefinitionId, sourceSnapshotId])
}

/// Versioned registry of GM, system, or plugin-defined model elements.
model ModelRegistry {
  id               String                @id @default(uuid())
  key              String
  name             String
  description      String?
  provenance       Json
  ownerUserId      String?
  metadataRevision Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            User?                 @relation("ModelRegistryOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  elements         ModelElementLineage[]
  releases         ModelSchemaRelease[]
  migrationPlans   ModelMigrationPlan[]

  @@unique([ownerUserId, key])
  @@index([ownerUserId, name])
}

model ModelElementLineage {
  id                String                      @id @default(uuid())
  registryId        String
  key               String
  kind              String
  semanticRole      String
  applicability     Json
  status            ModelElementLifecycleStatus @default(ACTIVE)
  currentRevisionId String?                     @unique
  metadataRevision  Int                         @default(1)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  archivedAt        DateTime?
  registry          ModelRegistry               @relation(fields: [registryId], references: [id], onDelete: Restrict)
  revisions         ModelElementRevision[]      @relation("ModelElementRevisions")
  currentRevision   ModelElementRevision?       @relation("ModelElementCurrentRevision", fields: [id, currentRevisionId], references: [elementId, id], onDelete: Restrict)

  @@unique([registryId, key])
  @@unique([id, currentRevisionId])
  @@index([registryId, kind, status])
  @@index([semanticRole])
}

/// Immutable payload and presentation for one model element revision.
model ModelElementRevision {
  id                    String                 @id @default(uuid())
  elementId             String
  revisionNumber        Int
  predecessorRevisionId String?
  payload               Json
  presentation          Json
  dependencies          Json                   @default("[]")
  source                Json?
  contentHash           String
  authoredByUserId      String?
  createdAt             DateTime               @default(now())
  publishedAt           DateTime               @default(now())
  element               ModelElementLineage    @relation("ModelElementRevisions", fields: [elementId], references: [id], onDelete: Restrict)
  currentForElement     ModelElementLineage?   @relation("ModelElementCurrentRevision")
  predecessorRevision   ModelElementRevision?  @relation("ModelElementRevisionLineage", fields: [elementId, predecessorRevisionId], references: [elementId, id], onDelete: Restrict)
  successorRevisions    ModelElementRevision[] @relation("ModelElementRevisionLineage")
  authoredBy            User?                  @relation("ModelElementRevisionAuthor", fields: [authoredByUserId], references: [id], onDelete: Restrict)

  @@unique([elementId, revisionNumber])
  @@unique([elementId, id])
  @@index([predecessorRevisionId])
  @@index([contentHash])
}

/// Immutable exact selection of model element revisions.
model ModelSchemaRelease {
  id                      String                                      @id @default(uuid())
  registryId              String
  revisionNumber          Int
  predecessorRevisionId   String?
  name                    String
  elementSelections       Json
  dependencies            Json                                        @default("[]")
  contentHash             String
  publishedByUserId       String?
  createdAt               DateTime                                    @default(now())
  publishedAt             DateTime                                    @default(now())
  registry                ModelRegistry                               @relation(fields: [registryId], references: [id], onDelete: Restrict)
  predecessorRevision     ModelSchemaRelease?                         @relation("ModelSchemaReleaseLineage", fields: [registryId, predecessorRevisionId], references: [registryId, id], onDelete: Restrict)
  successorRevisions      ModelSchemaRelease[]                        @relation("ModelSchemaReleaseLineage")
  publishedBy             User?                                       @relation("ModelSchemaReleasePublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  migrationSources        ModelMigrationPlan[]                        @relation("ModelMigrationSource")
  migrationTargets        ModelMigrationPlan[]                        @relation("ModelMigrationTarget")
  worldRevisionSelections WorldDefinitionRevisionModelSchemaRelease[]

  @@unique([registryId, revisionNumber])
  @@unique([registryId, id])
  @@index([predecessorRevisionId])
  @@index([contentHash])
}

/// Exact ordered Model Schema Release selection adopted by a published World revision.
model WorldDefinitionRevisionModelSchemaRelease {
  worldDefinitionRevisionId String
  modelSchemaReleaseId      String
  selectionOrder            Int
  worldDefinitionRevision   WorldDefinitionRevision @relation(fields: [worldDefinitionRevisionId], references: [id], onDelete: Restrict)
  modelSchemaRelease        ModelSchemaRelease      @relation(fields: [modelSchemaReleaseId], references: [id], onDelete: Restrict)

  @@id([worldDefinitionRevisionId, modelSchemaReleaseId])
  @@unique([worldDefinitionRevisionId, selectionOrder])
  @@index([modelSchemaReleaseId])
}

model ModelMigrationPlan {
  id              String             @id @default(uuid())
  registryId      String
  sourceReleaseId String
  targetReleaseId String
  mappings        Json
  createdByUserId String
  createdAt       DateTime           @default(now())
  registry        ModelRegistry      @relation(fields: [registryId], references: [id], onDelete: Restrict)
  sourceRelease   ModelSchemaRelease @relation("ModelMigrationSource", fields: [registryId, sourceReleaseId], references: [registryId, id], onDelete: Restrict)
  targetRelease   ModelSchemaRelease @relation("ModelMigrationTarget", fields: [registryId, targetReleaseId], references: [registryId, id], onDelete: Restrict)
  createdBy       User               @relation("ModelMigrationPlanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([registryId, sourceReleaseId, targetReleaseId])
  @@index([targetReleaseId])
}

/// Stable identity for a Campaign Definition across authored revisions.
model CampaignDefinition {
  id                String                                  @id @default(uuid())
  worldDefinitionId String
  name              String
  description       String?
  status            DefinitionLineageStatus                 @default(ACTIVE)
  currentRevisionId String?                                 @unique
  ownerUserId       String?
  createdAt         DateTime                                @default(now())
  updatedAt         DateTime                                @updatedAt
  archivedAt        DateTime?
  worldDefinition   WorldDefinition                         @relation(fields: [worldDefinitionId], references: [id], onDelete: Restrict)
  owner             User?                                   @relation("CampaignDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  revisions         CampaignDefinitionRevision[]            @relation("CampaignDefinitionRevisions")
  currentRevision   CampaignDefinitionRevision?             @relation("CampaignDefinitionCurrentRevision", fields: [id, currentRevisionId], references: [campaignDefinitionId, id], onDelete: Restrict)
  instances         CampaignInstance[]
  draft             CampaignDefinitionDraft?
  forkProvenance    CampaignDefinitionForkProvenance?       @relation("ForkTargetCampaign")
  forkSources       CampaignDefinitionForkProvenance[]      @relation("ForkSourceCampaign")
  worldMigrations   CampaignDefinitionWorldMigrationAudit[]
  metadataRevision  Int                                     @default(1)

  @@unique([id, worldDefinitionId])
  @@unique([id, currentRevisionId])
  @@index([worldDefinitionId, status])
  @@index([ownerUserId, status])
}

/// Immutable Campaign content and the World snapshot used to author it.
model CampaignDefinitionRevision {
  id                      String                                  @id @default(uuid())
  campaignDefinitionId    String
  worldDefinitionId       String
  capturedWorldSnapshotId String
  revisionNumber          Int
  predecessorRevisionId   String?
  name                    String
  content                 Json
  contentHash             String
  createdByUserId         String?
  createdAt               DateTime                                @default(now())
  publishedAt             DateTime                                @default(now())
  campaignDefinition      CampaignDefinition                      @relation("CampaignDefinitionRevisions", fields: [campaignDefinitionId, worldDefinitionId], references: [id, worldDefinitionId], onDelete: Restrict)
  currentForCampaign      CampaignDefinition?                     @relation("CampaignDefinitionCurrentRevision")
  capturedWorldSnapshot   WorldDefinitionSnapshot                 @relation(fields: [capturedWorldSnapshotId, worldDefinitionId], references: [id, worldDefinitionId], onDelete: Restrict)
  predecessorRevision     CampaignDefinitionRevision?             @relation("CampaignRevisionLineage", fields: [campaignDefinitionId, predecessorRevisionId], references: [campaignDefinitionId, id], onDelete: Restrict)
  successorRevisions      CampaignDefinitionRevision[]            @relation("CampaignRevisionLineage")
  createdBy               User?                                   @relation("CampaignRevisionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  snapshots               CampaignDefinitionSnapshot[]
  sourceDraftRevision     Int?
  basedDrafts             CampaignDefinitionDraft[]
  sourceWorldMigrations   CampaignDefinitionWorldMigrationAudit[] @relation("CampaignMigrationSourceRevision")
  resultWorldMigrations   CampaignDefinitionWorldMigrationAudit[] @relation("CampaignMigrationResultRevision")

  @@unique([campaignDefinitionId, revisionNumber])
  @@unique([campaignDefinitionId, id])
  @@unique([campaignDefinitionId, sourceDraftRevision])
  @@unique([id, campaignDefinitionId, capturedWorldSnapshotId])
  @@index([capturedWorldSnapshotId, worldDefinitionId])
  @@index([predecessorRevisionId])
  @@index([contentHash])
  @@index([publishedAt])
}

/// Immutable, content-addressed replica of one published Campaign revision.
model CampaignDefinitionSnapshot {
  id                           String                             @id @default(uuid())
  campaignDefinitionId         String
  campaignDefinitionRevisionId String
  capturedWorldSnapshotId      String
  manifest                     Json
  contentHash                  String
  capturedAt                   DateTime                           @default(now())
  campaignDefinitionRevision   CampaignDefinitionRevision         @relation(fields: [campaignDefinitionRevisionId, campaignDefinitionId, capturedWorldSnapshotId], references: [id, campaignDefinitionId, capturedWorldSnapshotId], onDelete: Restrict)
  capturedWorldSnapshot        WorldDefinitionSnapshot            @relation(fields: [capturedWorldSnapshotId], references: [id], onDelete: Restrict)
  instanceSnapshots            CampaignInstanceSnapshot[]
  basedDrafts                  CampaignDefinitionDraft[]
  forkSources                  CampaignDefinitionForkProvenance[]

  @@unique([id, campaignDefinitionId, capturedWorldSnapshotId])
  @@unique([id, campaignDefinitionId])
  @@unique([id, campaignDefinitionId, campaignDefinitionRevisionId])
  @@unique([campaignDefinitionRevisionId])
  @@index([campaignDefinitionRevisionId, campaignDefinitionId, capturedWorldSnapshotId])
  @@index([capturedWorldSnapshotId])
  @@index([contentHash])
  @@index([capturedAt])
}

/// Mutable complete working state for the next Campaign Definition publication.
model CampaignDefinitionDraft {
  id                       String                          @id @default(uuid())
  campaignDefinitionId     String                          @unique
  worldDefinitionId        String
  baseRevisionId           String?
  baseSnapshotId           String?
  capturedWorldSnapshotId  String
  revisionName             String
  content                  Json
  snapshotRecords          Json                            @default("[]")
  storageRevision          Int                             @default(1)
  validationStatus         DefinitionDraftValidationStatus @default(NOT_VALIDATED)
  validatedStorageRevision Int?
  validationReport         Json?
  createdByUserId          String
  updatedByUserId          String
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  campaignDefinition       CampaignDefinition              @relation(fields: [campaignDefinitionId, worldDefinitionId], references: [id, worldDefinitionId], onDelete: Restrict)
  baseRevision             CampaignDefinitionRevision?     @relation(fields: [campaignDefinitionId, baseRevisionId], references: [campaignDefinitionId, id], onDelete: Restrict)
  baseSnapshot             CampaignDefinitionSnapshot?     @relation(fields: [baseSnapshotId, campaignDefinitionId, baseRevisionId], references: [id, campaignDefinitionId, campaignDefinitionRevisionId], onDelete: Restrict)
  capturedWorldSnapshot    WorldDefinitionSnapshot         @relation(fields: [capturedWorldSnapshotId, worldDefinitionId], references: [id, worldDefinitionId], onDelete: Restrict)
  createdBy                User                            @relation("CampaignDraftCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                User                            @relation("CampaignDraftUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([campaignDefinitionId, worldDefinitionId])
  @@index([campaignDefinitionId, validationStatus])
  @@index([capturedWorldSnapshotId])
  @@index([baseSnapshotId])
}

/// Immutable provenance for a new Campaign lineage copied from a selected snapshot.
model CampaignDefinitionForkProvenance {
  targetCampaignDefinitionId String                     @id
  sourceCampaignDefinitionId String
  sourceSnapshotId           String
  identityMapping            Json
  createdByUserId            String
  createdAt                  DateTime                   @default(now())
  targetCampaignDefinition   CampaignDefinition         @relation("ForkTargetCampaign", fields: [targetCampaignDefinitionId], references: [id], onDelete: Restrict)
  sourceCampaignDefinition   CampaignDefinition         @relation("ForkSourceCampaign", fields: [sourceCampaignDefinitionId], references: [id], onDelete: Restrict)
  sourceSnapshot             CampaignDefinitionSnapshot @relation(fields: [sourceSnapshotId, sourceCampaignDefinitionId], references: [id, campaignDefinitionId], onDelete: Restrict)
  createdBy                  User                       @relation("CampaignForkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([sourceCampaignDefinitionId, sourceSnapshotId])
}

/// Append-only record of an all-or-nothing World snapshot adoption.
model CampaignDefinitionWorldMigrationAudit {
  id                            String                     @id @default(uuid())
  campaignDefinitionId          String
  predecessorCampaignRevisionId String
  sourceWorldSnapshotId         String
  targetWorldSnapshotId         String
  resultCampaignRevisionId      String                     @unique
  sourceDraftRevision           Int
  resolutionPlan                Json
  planHash                      String
  createdByUserId               String
  appliedAt                     DateTime                   @default(now())
  campaignDefinition            CampaignDefinition         @relation(fields: [campaignDefinitionId], references: [id], onDelete: Restrict, map: "CampaignWorldMigration_campaign_fkey")
  predecessorCampaignRevision   CampaignDefinitionRevision @relation("CampaignMigrationSourceRevision", fields: [predecessorCampaignRevisionId, campaignDefinitionId, sourceWorldSnapshotId], references: [id, campaignDefinitionId, capturedWorldSnapshotId], onDelete: Restrict, map: "CampaignWorldMigration_source_revision_fkey")
  resultCampaignRevision        CampaignDefinitionRevision @relation("CampaignMigrationResultRevision", fields: [resultCampaignRevisionId, campaignDefinitionId, targetWorldSnapshotId], references: [id, campaignDefinitionId, capturedWorldSnapshotId], onDelete: Restrict, map: "CampaignWorldMigration_result_revision_fkey")
  createdBy                     User                       @relation("CampaignWorldMigrationActor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([campaignDefinitionId, sourceDraftRevision])
  @@index([sourceWorldSnapshotId, targetWorldSnapshotId])
  @@index([appliedAt])
}

/// One played realization of a Campaign Definition for a durable group and history.
model CampaignInstance {
  id                     String                                 @id @default(uuid())
  campaignDefinitionId   String
  name                   String
  status                 CampaignInstanceStatus                 @default(PREPARING)
  currentSnapshotId      String?                                @unique
  createdByUserId        String?
  ownerUserId            String?
  creationKeyHash        String?
  metadataRevision       Int                                    @default(1)
  createdAt              DateTime                               @default(now())
  updatedAt              DateTime                               @updatedAt
  concludedAt            DateTime?
  archivedAt             DateTime?
  campaignDefinition     CampaignDefinition                     @relation(fields: [campaignDefinitionId], references: [id], onDelete: Restrict)
  createdBy              User?                                  @relation("CampaignInstanceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  owner                  User?                                  @relation("CampaignInstanceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  snapshots              CampaignInstanceSnapshot[]             @relation("CampaignInstanceSnapshots")
  currentSnapshot        CampaignInstanceSnapshot?              @relation("CampaignInstanceCurrentSnapshot", fields: [id, currentSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  runtime                CampaignInstanceRuntime?
  humanMemberships       CampaignInstanceHumanMembership[]
  invitations            CampaignInstanceInvitation[]
  agentParticipations    CampaignInstanceAgentParticipation[]
  sessions               CampaignInstanceSession[]
  characters             CampaignInstanceCharacterAssociation[] @relation("CharacterInstance")
  characterDrafts        CampaignInstanceCharacterDraft[]
  characterImportSources CampaignInstanceCharacterAssociation[] @relation("CharacterImportSourceInstance")
  runtimeCheckpoints     CampaignInstanceRuntimeCheckpoint[]
  migrationAudits        CampaignInstanceMigrationAudit[]
  auditEvents            CampaignInstanceAuditEvent[]

  @@unique([id, campaignDefinitionId])
  @@unique([id, currentSnapshotId])
  @@unique([ownerUserId, creationKeyHash])
  @@index([campaignDefinitionId, status])
  @@index([createdByUserId, status])
  @@index([ownerUserId, status])
}

/// Durable human participation in exactly one Campaign Instance.
model CampaignInstanceHumanMembership {
  id                    String                                 @id @default(uuid())
  campaignInstanceId    String
  userId                String
  playerProfileId       String?
  displayName           String
  role                  CampaignInstanceHumanRole
  status                CampaignInstanceMembershipStatus       @default(ACTIVE)
  activeCharacterId     String?
  joinedAt              DateTime                               @default(now())
  leftAt                DateTime?
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt
  campaignInstance      CampaignInstance                       @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  user                  User                                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  playerProfile         PlayerProfile?                         @relation(fields: [playerProfileId, userId], references: [id, userId], onDelete: Restrict)
  acceptedInvitations   CampaignInstanceInvitation[]
  characters            CampaignInstanceCharacterAssociation[] @relation("MembershipCharacters")
  characterDrafts       CampaignInstanceCharacterDraft[]
  activeCharacter       CampaignInstanceCharacterAssociation?  @relation("MembershipActiveCharacter", fields: [campaignInstanceId, id, activeCharacterId], references: [campaignInstanceId, playerMembershipId, characterId], onDelete: Restrict)
  sessionParticipations SessionParticipation[]

  @@unique([campaignInstanceId, userId])
  @@unique([campaignInstanceId, id])
  @@unique([campaignInstanceId, id, role])
  @@unique([campaignInstanceId, id, activeCharacterId])
  @@index([playerProfileId, status])
  @@index([campaignInstanceId, role, status])
  @@index([activeCharacterId])
}

/// Instance-scoped invitation. Contact values and invitation credentials are
/// never stored in plaintext. Database checks bind acceptance/revocation
/// timestamps and membership presence to the invitation status.
model CampaignInstanceInvitation {
  id                   String                                      @id @default(uuid())
  campaignInstanceId   String
  role                 CampaignInstanceHumanRole
  invitedName          String?
  invitedUserId        String?
  emailEncrypted       String?
  emailHash            String?
  phoneEncrypted       String?
  phoneHash            String?
  tokenHash            String                                      @unique
  deliveryReference    String?
  status               CampaignInstanceInvitationStatus            @default(PENDING)
  expiresAt            DateTime
  acceptedMembershipId String?
  createdByUserId      String
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime                                    @default(now())
  updatedAt            DateTime                                    @updatedAt
  campaignInstance     CampaignInstance                            @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  invitedUser          User?                                       @relation("CampaignInstanceInvitationUser", fields: [invitedUserId], references: [id], onDelete: Restrict)
  createdBy            User                                        @relation("CampaignInstanceInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedMembership   CampaignInstanceHumanMembership?            @relation(fields: [campaignInstanceId, acceptedMembershipId, role], references: [campaignInstanceId, id, role], onDelete: Restrict)
  deliveryAttempts     CampaignInstanceInvitationDeliveryAttempt[]

  @@unique([campaignInstanceId, id])
  @@index([campaignInstanceId, status])
  @@index([campaignInstanceId, emailHash])
  @@index([campaignInstanceId, phoneHash])
  @@index([invitedUserId, status])
  @@index([expiresAt])
}

/// One contact-free delivery attempt for an Instance invitation.
model CampaignInstanceInvitationDeliveryAttempt {
  id                 String                     @id @default(uuid())
  campaignInstanceId String
  invitationId       String
  channel            DeliveryChannel
  status             DeliveryStatus
  providerReference  String?
  failureCategory    String?
  attemptedAt        DateTime                   @default(now())
  invitation         CampaignInstanceInvitation @relation(fields: [campaignInstanceId, invitationId], references: [campaignInstanceId, id], onDelete: Restrict)

  @@index([campaignInstanceId, invitationId, attemptedAt])
}

/// Least-privilege authorization for one non-human Agent in one Instance.
/// Capability JSON is database-checked as arrays of open namespaced string keys.
model CampaignInstanceAgentParticipation {
  id                    String                                   @id @default(uuid())
  campaignInstanceId    String
  agentId               String
  agentName             String
  participantKind       String                                   @default("non-human-agent")
  status                CampaignInstanceAgentParticipationStatus @default(CONFIGURED)
  observeCapabilities   Json                                     @default("[]")
  actCapabilities       Json                                     @default("[]")
  createdAt             DateTime                                 @default(now())
  updatedAt             DateTime                                 @updatedAt
  campaignInstance      CampaignInstance                         @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  agent                 AgentIdentity                            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  sessionParticipations SessionParticipation[]

  @@unique([campaignInstanceId, agentId])
  @@unique([campaignInstanceId, id])
  @@index([campaignInstanceId, status])
  @@index([agentId, status])
}

/// A scheduled or historical Session owned by one Campaign Instance. Database
/// checks keep lifecycle timestamps consistent with the Session status.
model CampaignInstanceSession {
  id                     String                           @id @default(uuid())
  campaignInstanceId     String
  name                   String
  status                 CampaignInstanceSessionStatus    @default(PLANNED)
  metadataRevision       Int                              @default(1)
  planningNotes          String?
  creationKeyHash        String?
  createdByUserId        String?
  scheduledFor           DateTime?
  lobbyOpenedAt          DateTime?
  startedAt              DateTime?
  pausedAt               DateTime?
  resumedAt              DateTime?
  concludedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  startSnapshotId        String?
  startRuntimeRevision   Int?
  lastRuntimeRevision    Int?
  endSnapshotId          String?
  endRuntimeRevision     Int?
  firstEventSequence     Int?
  lastEventSequence      Int?
  currentSummaryRevision Int?
  summaryStatus          SessionSummaryStatus?
  eventLog               Json                             @default("[]")
  summary                Json?
  extensions             Json                             @default("{}")
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  campaignInstance       CampaignInstance                 @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  createdBy              User?                            @relation("CampaignSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  startSnapshot          CampaignInstanceSnapshot?        @relation("CampaignSessionStartSnapshot", fields: [campaignInstanceId, startSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  endSnapshot            CampaignInstanceSnapshot?        @relation("CampaignSessionEndSnapshot", fields: [campaignInstanceId, endSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  participations         SessionParticipation[]
  invitations            CampaignSessionInvitation[]
  presenceLeases         SessionPresenceLease[]
  events                 CampaignSessionEvent[]
  runtimeBoundaries      CampaignSessionRuntimeBoundary[]
  summaries              CampaignSessionSummary[]
  outboxEvents           CampaignSessionOutboxEvent[]

  @@unique([campaignInstanceId, id])
  @@unique([campaignInstanceId, creationKeyHash])
  @@index([campaignInstanceId, status, scheduledFor])
  @@index([status, updatedAt])
}

/// Session attendance is separate from durable Instance membership. Exactly
/// one human membership or Agent participation is referenced.
model SessionParticipation {
  id                   String                              @id @default(uuid())
  campaignInstanceId   String
  sessionId            String
  humanMembershipId    String?
  agentParticipationId String?
  participantName      String
  role                 SessionParticipantRole
  required             Boolean                             @default(false)
  selected             Boolean                             @default(true)
  scheduledAt          DateTime?
  response             SessionResponseStatus               @default(NOT_REQUESTED)
  responseMessage      String?
  respondedAt          DateTime?
  attendance           SessionAttendanceStatus             @default(PENDING)
  joinedAt             DateTime?
  leftAt               DateTime?
  acted                Boolean                             @default(false)
  totalPresentSeconds  Int                                 @default(0)
  observeCapabilities  Json                                @default("[]")
  actCapabilities      Json                                @default("[]")
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  session              CampaignInstanceSession             @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)
  humanMembership      CampaignInstanceHumanMembership?    @relation(fields: [campaignInstanceId, humanMembershipId], references: [campaignInstanceId, id], onDelete: Restrict)
  agentParticipation   CampaignInstanceAgentParticipation? @relation(fields: [campaignInstanceId, agentParticipationId], references: [campaignInstanceId, id], onDelete: Restrict)
  invitations          CampaignSessionInvitation[]
  presenceLeases       SessionPresenceLease[]
  authoredEvents       CampaignSessionEvent[]              @relation("CampaignSessionEventParticipation")

  @@unique([sessionId, humanMembershipId])
  @@unique([sessionId, agentParticipationId])
  @@unique([campaignInstanceId, sessionId, id])
  @@index([campaignInstanceId, sessionId])
  @@index([campaignInstanceId, humanMembershipId])
  @@index([campaignInstanceId, agentParticipationId])
  @@index([sessionId, attendance])
}

model CampaignSessionInvitation {
  id                      String                                     @id @default(uuid())
  campaignInstanceId      String
  sessionId               String
  participationId         String
  revision                Int                                        @default(1)
  predecessorInvitationId String?
  tokenHash               String                                     @unique
  status                  SessionInvitationStatus                    @default(PENDING)
  expiresAt               DateTime
  issuedByUserId          String
  issuedAt                DateTime                                   @default(now())
  acceptedAt              DateTime?
  revokedAt               DateTime?
  session                 CampaignInstanceSession                    @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)
  participation           SessionParticipation                       @relation(fields: [campaignInstanceId, sessionId, participationId], references: [campaignInstanceId, sessionId, id], onDelete: Restrict, map: "CampaignSessionInvitation_campaignInstanceId_sessionId_par_fkey")
  predecessor             CampaignSessionInvitation?                 @relation("CampaignSessionInvitationLineage", fields: [campaignInstanceId, sessionId, participationId, predecessorInvitationId], references: [campaignInstanceId, sessionId, participationId, id], onDelete: Restrict, map: "CampaignSessionInvitation_predecessor_scope_fkey")
  reissues                CampaignSessionInvitation[]                @relation("CampaignSessionInvitationLineage")
  issuedBy                User                                       @relation("CampaignSessionInvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  deliveryAttempts        CampaignSessionInvitationDeliveryAttempt[]

  @@unique([campaignInstanceId, sessionId, id])
  @@unique([campaignInstanceId, sessionId, participationId, id], map: "CampaignSessionInvitation_scope_id_key")
  @@unique([participationId, revision])
  @@index([sessionId, status])
  @@index([expiresAt])
}

model CampaignSessionInvitationDeliveryAttempt {
  id                 String                    @id @default(uuid())
  campaignInstanceId String
  sessionId          String
  invitationId       String
  channel            DeliveryChannel
  status             DeliveryStatus
  providerReference  String?
  failureCategory    String?
  attemptedAt        DateTime                  @default(now())
  invitation         CampaignSessionInvitation @relation(fields: [campaignInstanceId, sessionId, invitationId], references: [campaignInstanceId, sessionId, id], onDelete: Restrict)

  @@index([invitationId, attemptedAt])
}

model SessionPresenceLease {
  id                 String                  @id @default(uuid())
  campaignInstanceId String
  sessionId          String
  participationId    String
  connectionKeyHash  String                  @unique
  phase              SessionPresencePhase
  joinedAt           DateTime                @default(now())
  lastHeartbeatAt    DateTime                @default(now())
  expiresAt          DateTime
  leftAt             DateTime?
  ejectedAt          DateTime?
  session            CampaignInstanceSession @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)
  participation      SessionParticipation    @relation(fields: [campaignInstanceId, sessionId, participationId], references: [campaignInstanceId, sessionId, id], onDelete: Restrict)

  @@index([sessionId, expiresAt])
  @@index([participationId, expiresAt])
}

model CampaignSessionEvent {
  id                    String                  @id @default(uuid())
  campaignInstanceId    String
  sessionId             String
  sequence              Int
  occurredAt            DateTime                @default(now())
  campaignTime          String?
  type                  String
  summary               String
  actorName             String
  actorUserId           String?
  actorParticipationId  String?
  visibility            SessionEventVisibility  @default(PARTICIPANTS)
  runtimeRevisionBefore Int?
  runtimeRevisionAfter  Int?
  causedBySequence      Int?
  payload               Json?
  extensions            Json                    @default("{}")
  previousHash          String?
  contentHash           String
  session               CampaignInstanceSession @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)
  actorUser             User?                   @relation("CampaignSessionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorParticipation    SessionParticipation?   @relation("CampaignSessionEventParticipation", fields: [campaignInstanceId, sessionId, actorParticipationId], references: [campaignInstanceId, sessionId, id], onDelete: Restrict)

  @@unique([sessionId, sequence])
  @@index([sessionId, occurredAt])
}

model CampaignSessionRuntimeBoundary {
  id                 String                   @id @default(uuid())
  campaignInstanceId String
  sessionId          String
  snapshotId         String
  runtimeRevision    Int
  reason             SessionBoundaryReason
  eventSequence      Int
  contentHash        String
  actorUserId        String
  createdAt          DateTime                 @default(now())
  session            CampaignInstanceSession  @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)
  snapshot           CampaignInstanceSnapshot @relation(fields: [campaignInstanceId, snapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  actor              User                     @relation("CampaignSessionBoundaryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([sessionId, eventSequence])
  @@index([campaignInstanceId, snapshotId])
}

model CampaignSessionSummary {
  id                   String                  @id @default(uuid())
  campaignInstanceId   String
  sessionId            String
  revision             Int
  status               SessionSummaryStatus
  eventSequenceThrough Int
  narrative            String
  privateGmNotes       String?
  createdByUserId      String
  createdAt            DateTime                @default(now())
  approvedAt           DateTime?
  session              CampaignInstanceSession @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)
  createdBy            User                    @relation("CampaignSessionSummaryAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([sessionId, revision])
  @@index([sessionId, status])
}

model CampaignSessionOutboxEvent {
  id                 String                  @id @default(uuid())
  campaignInstanceId String
  sessionId          String
  type               String
  payload            Json
  createdAt          DateTime                @default(now())
  deliveredAt        DateTime?
  session            CampaignInstanceSession @relation(fields: [campaignInstanceId, sessionId], references: [campaignInstanceId, id], onDelete: Restrict)

  @@index([type, deliveredAt, createdAt])
}

/// Exactly-one-Instance Character ownership plus optional one-way import provenance.
model CampaignInstanceCharacterAssociation {
  characterId                String                                 @id
  characterName              String
  campaignInstanceId         String
  playerMembershipId         String
  playerMembershipRole       CampaignInstanceHumanRole              @default(PLAYER)
  status                     CampaignInstanceCharacterStatus        @default(DRAFT)
  origin                     CharacterAssociationOrigin             @default(CREATED_IN_INSTANCE)
  sourceCampaignInstanceId   String?
  sourceCharacterId          String?
  sourceCampaignInstanceName String?
  sourceCharacterName        String?
  importedAt                 DateTime?
  createdAt                  DateTime                               @default(now())
  updatedAt                  DateTime                               @updatedAt
  campaignInstance           CampaignInstance                       @relation("CharacterInstance", fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  playerMembership           CampaignInstanceHumanMembership        @relation("MembershipCharacters", fields: [campaignInstanceId, playerMembershipId, playerMembershipRole], references: [campaignInstanceId, id, role], onDelete: Restrict)
  activeForMembership        CampaignInstanceHumanMembership?       @relation("MembershipActiveCharacter")
  sourceCampaignInstance     CampaignInstance?                      @relation("CharacterImportSourceInstance", fields: [sourceCampaignInstanceId], references: [id], onDelete: Restrict, map: "CampaignInstanceCharacterAssociation_sourceInstance_fkey")
  sourceAssociation          CampaignInstanceCharacterAssociation?  @relation("CharacterImportSource", fields: [sourceCampaignInstanceId, sourceCharacterId], references: [campaignInstanceId, characterId], onDelete: Restrict, map: "CampaignInstanceCharacterAssociation_sourceAssociation_fkey")
  importedAssociations       CampaignInstanceCharacterAssociation[] @relation("CharacterImportSource")
  draft                      CampaignInstanceCharacterDraft?

  @@unique([campaignInstanceId, characterId])
  @@unique([campaignInstanceId, playerMembershipId, characterId])
  @@index([campaignInstanceId, playerMembershipId, status])
  @@index([sourceCampaignInstanceId, sourceCharacterId])
}

/// Resumable player-authored sheet for a Character already bound to exactly one Instance.
model CampaignInstanceCharacterDraft {
  id                     String                               @id @default(uuid())
  campaignInstanceId     String
  playerMembershipId     String
  characterId            String                               @unique
  revision               Int                                  @default(1)
  status                 CharacterDraftStatus                 @default(IN_PROGRESS)
  name                   String?
  backgroundDefinitionId String?
  professionDefinitionId String?
  heritageDefinitionIds  Json                                 @default("[]")
  attributeRolls         Json                                 @default("[]")
  attributeAssignments   Json                                 @default("{}")
  startingEquipmentIds   Json                                 @default("[]")
  biography              String?
  imageAssetIds          Json                                 @default("{}")
  submittedAt            DateTime?
  reviewedAt             DateTime?
  reviewedByUserId       String?
  reviewNote             String?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  campaignInstance       CampaignInstance                     @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict, map: "CampaignInstanceCharacterDraft_campaignInstanceId_fkey")
  playerMembership       CampaignInstanceHumanMembership      @relation(fields: [campaignInstanceId, playerMembershipId], references: [campaignInstanceId, id], onDelete: Restrict, map: "CampaignInstanceCharacterDraft_membership_fkey")
  character              CampaignInstanceCharacterAssociation @relation(fields: [campaignInstanceId, playerMembershipId, characterId], references: [campaignInstanceId, playerMembershipId, characterId], onDelete: Restrict, map: "CampaignInstanceCharacterDraft_character_fkey")
  reviewedBy             User?                                @relation("CampaignInstanceCharacterDraftReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, map: "InstanceCharacterDraft_reviewer_fkey")

  @@unique([campaignInstanceId, playerMembershipId, characterId], map: "InstanceCharacterDraft_membership_character_key")
  @@index([campaignInstanceId, playerMembershipId, status], map: "InstanceCharacterDraft_membership_status_idx")
  @@index([playerMembershipId, status], map: "InstanceCharacterDraft_player_status_idx")
  @@index([reviewedByUserId, reviewedAt], map: "InstanceCharacterDraft_reviewer_idx")
}

/// Immutable compatible Campaign/World capture used by a Campaign Instance.
model CampaignInstanceSnapshot {
  id                           String                              @id @default(uuid())
  campaignInstanceId           String
  campaignDefinitionId         String
  campaignDefinitionSnapshotId String
  worldDefinitionSnapshotId    String
  snapshotNumber               Int
  predecessorSnapshotId        String?
  reason                       InstanceSnapshotReason
  manifest                     Json
  contentHash                  String
  migrationPlan                Json?
  createdByUserId              String?
  adoptedAt                    DateTime                            @default(now())
  campaignInstance             CampaignInstance                    @relation("CampaignInstanceSnapshots", fields: [campaignInstanceId, campaignDefinitionId], references: [id, campaignDefinitionId], onDelete: Restrict)
  currentForInstance           CampaignInstance?                   @relation("CampaignInstanceCurrentSnapshot")
  campaignDefinitionSnapshot   CampaignDefinitionSnapshot          @relation(fields: [campaignDefinitionSnapshotId, campaignDefinitionId, worldDefinitionSnapshotId], references: [id, campaignDefinitionId, capturedWorldSnapshotId], onDelete: Restrict)
  worldDefinitionSnapshot      WorldDefinitionSnapshot             @relation(fields: [worldDefinitionSnapshotId], references: [id], onDelete: Restrict)
  predecessorSnapshot          CampaignInstanceSnapshot?           @relation("CampaignInstanceSnapshotLineage", fields: [campaignInstanceId, predecessorSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  subsequentSnapshots          CampaignInstanceSnapshot[]          @relation("CampaignInstanceSnapshotLineage")
  createdBy                    User?                               @relation("CampaignSnapshotAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  runtime                      CampaignInstanceRuntime?
  runtimeCheckpoints           CampaignInstanceRuntimeCheckpoint[]
  sourceMigrationAudits        CampaignInstanceMigrationAudit[]    @relation("CampaignInstanceMigrationSourceSnapshot")
  resultMigrationAudit         CampaignInstanceMigrationAudit?     @relation("CampaignInstanceMigrationResultSnapshot")
  sessionStartBoundaries       CampaignInstanceSession[]           @relation("CampaignSessionStartSnapshot")
  sessionEndBoundaries         CampaignInstanceSession[]           @relation("CampaignSessionEndSnapshot")
  sessionRuntimeBoundaries     CampaignSessionRuntimeBoundary[]

  @@unique([campaignInstanceId, snapshotNumber])
  @@unique([campaignInstanceId, id])
  @@unique([campaignInstanceId, id, predecessorSnapshotId])
  @@index([campaignDefinitionSnapshotId, campaignDefinitionId, worldDefinitionSnapshotId])
  @@index([worldDefinitionSnapshotId])
  @@index([predecessorSnapshotId])
  @@index([contentHash])
  @@index([adoptedAt])
}

/// Mutable continuing state for one Campaign Instance and its adopted snapshot.
model CampaignInstanceRuntime {
  id                         String                   @id @default(uuid())
  campaignInstanceId         String                   @unique
  campaignInstanceSnapshotId String                   @unique
  state                      Json
  extensions                 Json                     @default("{}")
  revision                   Int                      @default(1)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  campaignInstance           CampaignInstance         @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  campaignInstanceSnapshot   CampaignInstanceSnapshot @relation(fields: [campaignInstanceId, campaignInstanceSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)

  @@unique([campaignInstanceId, campaignInstanceSnapshotId])
  @@index([updatedAt])
}

/// Immutable runtime state captured before and after Instance snapshot adoption.
/// Checkpoints preserve later Session history; restore never rewinds a mutable row.
model CampaignInstanceRuntimeCheckpoint {
  id                         String                                  @id @default(uuid())
  campaignInstanceId         String
  campaignInstanceSnapshotId String
  checkpointNumber           Int
  reason                     CampaignInstanceRuntimeCheckpointReason
  runtimeRevision            Int
  state                      Json
  extensions                 Json                                    @default("{}")
  contentHash                String
  createdByUserId            String?
  createdAt                  DateTime                                @default(now())
  campaignInstance           CampaignInstance                        @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  campaignInstanceSnapshot   CampaignInstanceSnapshot                @relation(fields: [campaignInstanceId, campaignInstanceSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  createdBy                  User?                                   @relation("CampaignRuntimeCheckpointAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceMigrationAudits      CampaignInstanceMigrationAudit[]        @relation("CampaignInstanceMigrationSourceCheckpoint")
  resultMigrationAudit       CampaignInstanceMigrationAudit?         @relation("CampaignInstanceMigrationResultCheckpoint")

  @@unique([campaignInstanceId, checkpointNumber])
  @@unique([campaignInstanceId, id])
  @@unique([campaignInstanceId, id, campaignInstanceSnapshotId])
  @@index([campaignInstanceSnapshotId, createdAt])
  @@index([contentHash])
}

/// Append-only provenance for one all-or-nothing direct-lineage migration or restore.
model CampaignInstanceMigrationAudit {
  id                        String                            @id @default(uuid())
  campaignInstanceId        String
  kind                      CampaignInstanceMigrationKind
  sourceSnapshotId          String
  resultSnapshotId          String                            @unique
  sourceRuntimeCheckpointId String
  resultRuntimeCheckpointId String                            @unique
  resolutionPlan            Json
  planHash                  String
  createdByUserId           String
  appliedAt                 DateTime                          @default(now())
  campaignInstance          CampaignInstance                  @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  sourceSnapshot            CampaignInstanceSnapshot          @relation("CampaignInstanceMigrationSourceSnapshot", fields: [campaignInstanceId, sourceSnapshotId], references: [campaignInstanceId, id], onDelete: Restrict)
  resultSnapshot            CampaignInstanceSnapshot          @relation("CampaignInstanceMigrationResultSnapshot", fields: [campaignInstanceId, resultSnapshotId, sourceSnapshotId], references: [campaignInstanceId, id, predecessorSnapshotId], onDelete: Restrict)
  sourceRuntimeCheckpoint   CampaignInstanceRuntimeCheckpoint @relation("CampaignInstanceMigrationSourceCheckpoint", fields: [campaignInstanceId, sourceRuntimeCheckpointId, sourceSnapshotId], references: [campaignInstanceId, id, campaignInstanceSnapshotId], onDelete: Restrict)
  resultRuntimeCheckpoint   CampaignInstanceRuntimeCheckpoint @relation("CampaignInstanceMigrationResultCheckpoint", fields: [campaignInstanceId, resultRuntimeCheckpointId, resultSnapshotId], references: [campaignInstanceId, id, campaignInstanceSnapshotId], onDelete: Restrict)
  createdBy                 User                              @relation("CampaignInstanceMigrationActor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([campaignInstanceId, resultSnapshotId, sourceSnapshotId])
  @@unique([campaignInstanceId, resultRuntimeCheckpointId, resultSnapshotId])
  @@index([campaignInstanceId, appliedAt])
  @@index([sourceSnapshotId, resultSnapshotId])
  @@index([planHash])
}

/// Append-only, human-resolvable audit event for Instance administration.
model CampaignInstanceAuditEvent {
  id                 String           @id @default(uuid())
  campaignInstanceId String
  actorUserId        String
  action             String
  subjectName        String
  subjectType        String
  detail             Json             @default("{}")
  createdAt          DateTime         @default(now())
  campaignInstance   CampaignInstance @relation(fields: [campaignInstanceId], references: [id], onDelete: Restrict)
  actor              User             @relation("CampaignInstanceAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([campaignInstanceId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Idempotent bridge from legacy resource identities to new aggregate identities.
/// targetType is deliberately open because a single legacy campaign may map to
/// both a Campaign Definition and a distinct Campaign Instance.
model LegacyIdentityMap {
  id                   String   @id @default(uuid())
  legacyResource       String
  legacyId             String
  targetType           String
  targetId             String
  targetRevisionId     String?
  sourceDomainRevision Int?
  mappingMetadata      Json     @default("{}")
  createdAt            DateTime @default(now())

  @@unique([legacyResource, legacyId, targetType])
  @@index([targetType, targetId])
  @@index([targetRevisionId])
}

/// Durable checkpoint for an additive installation-level data rollout.
model InstallationRolloutState {
  id                String                     @id @default(uuid())
  installationKey   String
  migrationKey      String
  phase             InstallationRolloutPhase   @default(PLANNED)
  sourceVersion     String?
  targetVersion     String
  preflightReport   Json?
  checkpoint        Json                       @default("{}")
  initiatedByUserId String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  initiatedBy       User?                      @relation("InstallationRolloutInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  auditEvents       InstallationRolloutAudit[]

  @@unique([installationKey, migrationKey])
  @@index([phase, updatedAt])
}

/// Append-only operator-visible history for rollout preflight, checkpoints, and cutover.
model InstallationRolloutAudit {
  id             String                   @id @default(uuid())
  rolloutStateId String
  phase          InstallationRolloutPhase
  action         String
  details        Json                     @default("{}")
  actorUserId    String?
  createdAt      DateTime                 @default(now())
  rolloutState   InstallationRolloutState @relation(fields: [rolloutStateId], references: [id], onDelete: Restrict)
  actor          User?                    @relation("InstallationRolloutAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([rolloutStateId, createdAt])
  @@index([phase, createdAt])
}
