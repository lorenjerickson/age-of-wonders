{
  "name": "@aow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "domain:migrate:science": "ts-node --files src/cli/migrate-science-domain.ts",
    "domain:migrate:science:apply": "ts-node --files src/cli/migrate-science-domain.ts --apply",
    "domain:preflight:realignment": "ts-node --files src/cli/preflight-domain-realignment.ts",
    "domain:materialize:realignment": "ts-node --files src/cli/materialize-domain-realignment-shadow.ts",
    "domain:materialize:realignment:apply": "ts-node --files src/cli/materialize-domain-realignment-shadow.ts --apply",
    "domain:archive:export": "ts-node --files src/cli/export-science-domain-archive.ts",
    "domain:archive:import": "ts-node --files src/cli/import-science-domain-archive.ts",
    "domain:archive:import:apply": "ts-node --files src/cli/import-science-domain-archive.ts --apply",
    "transfer:export": "ts-node --files src/cli/export-host-transfer.ts",
    "transfer:import": "ts-node --files src/cli/import-host-transfer.ts",
    "transfer:import:apply": "ts-node --files src/cli/import-host-transfer.ts --apply",
    "dev": "nest start --watch",
    "dev:docker": "prisma generate && prisma db push && nest start --watch --debug 0.0.0.0:9229",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aow/common": "workspace:*",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/lib-storage": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "levelgraph": "4.0.0",
    "multer": "^2.2.0",
    "openai": "^5.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "prisma": "^6.15.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
