# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=age_of_wonders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/age_of_wonders?schema=public

API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# The key is read only by the API container and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# S3-compatible object storage (MinIO defaults for local development).
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=age-of-wonders
S3_ACCESS_KEY=aow-minio
S3_SECRET_KEY=aow-minio-password
