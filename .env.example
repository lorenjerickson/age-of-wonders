# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=age_of_wonders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/age_of_wonders?schema=public

API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Used only by the TanStack Start server; browser requests stay same-origin at /api.
API_INTERNAL_URL=http://api:3000/api

# Bootstrap GM authentication and encrypted participant contact storage.
# Generate CONTACT_ENCRYPTION_KEY with: openssl rand -base64 32
GM_DISPLAY_NAME=Game Master
GM_BOOTSTRAP_TOKEN=development-gm-session-change-me
CONTACT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INVITATION_TTL_HOURS=168

# Local development captures outbound messages without calling a provider.
# Set EMAIL_PROVIDER=resend and SMS_PROVIDER=twilio for real delivery.
EMAIL_PROVIDER=capture
EMAIL_FROM=
RESEND_API_KEY=
SMS_PROVIDER=capture
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The key is read only by the API container and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# S3-compatible object storage (MinIO defaults for local development).
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=age-of-wonders
S3_ACCESS_KEY=aow-minio
S3_SECRET_KEY=aow-minio-password
